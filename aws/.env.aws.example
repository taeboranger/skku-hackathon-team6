# Copy to aws/.env.aws and fill in. Never commit the filled-in file.
# aws/deploy.sh uploads this to SSM Parameter Store as a SecureString;
# the instance reads it at boot into /etc/campus.env.

# ── Channel App (ask the hackathon organisers for real values) ────────
APP_ID=
APP_SECRET=
SIGNING_KEY=
APP_STORE_URL=https://app-store-api.channel.io

# APP_ORIGIN is set automatically by deploy.sh to the CloudFront URL.
APP_ORIGIN=

# ── AI: Letsur AI Gateway (OpenAI-compatible) ─────────────────────────
# https://platform.letsur.ai/guide  ·  models: GET /v1/models
LETSUR_API_KEY=
LETSUR_BASE_URL=https://gw.letsur.ai/v1
LETSUR_MODEL=gpt-4.1-mini

# ── Channel Desk integration (optional) ───────────────────────────────
CHANNEL_PLUGIN_KEY=
CHANNEL_MEMBER_HASH_SECRET=
CHANNEL_ACCESS_KEY=
CHANNEL_ACCESS_SECRET=
CHANNEL_WEBHOOK_TOKEN=
CHANNEL_INTAKE_MODE=

# ── Naver Maps (optional, for location lookup) ────────────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=

# ── Web push (optional) ───────────────────────────────────────────────
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:campus@example.com

# Cron runs in-process on the instance; this only guards the /api/jobs route.
CRON_SECRET=
